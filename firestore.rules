rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Tasks are read-only for users
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if false; 
    }
    
    // Rooms access
    match /rooms/{roomId} {
      allow read: if resource.data.mode == 'public' || 
                   (request.auth != null && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.invitedUsers));
      allow write: if request.auth != null;
    }

    match /bounties/{bountyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /test/{testId} {
      allow read: if true;
    }
  }
}
